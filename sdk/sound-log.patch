+// BARDOWN_XMA_DUMP=<dir> with BARDOWN_XMA_DUMP_WINDOW=<from>:<to> (seconds since the first decode): everything the
+// decoder hands the game in that window, to <dir>/xma-out.bin as records {u64 ns since first decode, u32 context,
+// u32 bytes, u32 stereo, u32 sample rate} then the bytes (16-bit samples, as written for the guest)
+void DumpOutput(uint32_t context, const XMA_CONTEXT_DATA* data, const uint8_t* bytes, uint32_t size) {
+  static const char* dir = std::getenv("BARDOWN_XMA_DUMP");
+  if (!dir || !*dir || !size) return;
+  static const auto start = std::chrono::steady_clock::now();
+  static double from = 0, to = 0;
+  static FILE* out = [] {
+    if (const char* w = std::getenv("BARDOWN_XMA_DUMP_WINDOW")) std::sscanf(w, "%lf:%lf", &from, &to);
+    return std::fopen((std::string(dir) + "/xma-out.bin").c_str(), "wb");
+  }();
+  const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start).count();
+  if (!out || ns < from * 1e9 || (to > 0 && ns > to * 1e9)) return;
+  static std::mutex mutex;
+  std::lock_guard lock(mutex);
+  const uint64_t when = uint64_t(ns);
+  const uint32_t head[4] = {context, size, uint32_t(data->is_stereo), uint32_t(data->sample_rate)};
+  std::fwrite(&when, 8, 1, out);
+  std::fwrite(head, 4, 4, out);
+  std::fwrite(bytes, 1, size, out);
+  std::fflush(out);
+}
