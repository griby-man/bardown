+  static double from = 0, to = 0;
+  static FILE* out = [] {
+    if (const char* w = std::getenv("BARDOWN_XMA_TRACE_WINDOW")) std::sscanf(w, "%lf:%lf", &from, &to);
+    return std::fopen(path, "w");
