@@ -38,6 +44,36 @@ extern "C" {
 
 namespace rex::audio {
 
+namespace {
+
+// BARDOWN_SOUND_LOG=<dir>: every input buffer a context starts on goes to <dir>/xma.txt with its
+// first bytes, so what the game plays can be matched to its sound banks.
+// a line: steady-clock ns, context, buffer address, packet count, 64 bytes hex
+void LogInputBuffer(uint32_t context, uint32_t address, uint32_t packets, const uint8_t* bytes) {
+  static std::mutex mutex;
+  static FILE* out = [] {
+    const char* dir = std::getenv("BARDOWN_SOUND_LOG");
+    return dir && *dir ? std::fopen((std::string(dir) + "/xma.txt").c_str(), "w") : nullptr;
+  }();
+  // a voice can reuse one buffer for the next sound, so it's the address and the bytes
+  static std::unordered_map<uint32_t, std::pair<uint32_t, uint64_t>> last;
+  if (!out) return;
+  uint64_t head;
+  std::memcpy(&head, bytes, 8);
+  std::lock_guard lock(mutex);
+  auto& seen = last[context];
+  if (seen.first == address && seen.second == head) return;
+  seen = {address, head};
+  auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count();
+  std::fprintf(out, "%lld %u %08x %u ", static_cast<long long>(ns), context, address, packets);
+  for (int i = 0; i < 64; ++i) std::fprintf(out, "%02x", bytes[i]);
+  std::fprintf(out, "\n");
+  std::fflush(out);
+}
+
+}  // namespace
