diff --git a/include/rex/ui/external_output.h b/include/rex/ui/external_output.h
new file mode 100644
index 0000000..a5e046a
--- /dev/null
+++ b/include/rex/ui/external_output.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <functional>
+
+#include <rex/ui/presenter.h>
+
+namespace rex::ui {
+
+// lets a renderer outside the gpu emulation own the picture: while set, the emulation's swaps no longer
+// refresh the guest output, and the outside renderer refreshes it through RefreshGuestOutputExternal
+void SetGuestOutputExternal(bool external);
+bool RefreshGuestOutputExternal(Presenter& presenter, uint32_t frontbuffer_width,
+                                uint32_t frontbuffer_height, uint32_t display_aspect_ratio_x,
+                                uint32_t display_aspect_ratio_y,
+                                std::function<bool(Presenter::GuestOutputRefreshContext& context)> refresher);
+
+// the outside renderer has taken a frame's data (called at each of its swaps). a gpu front end that draws
+// nothing holds each swap until then, so fences after it don't tell the game the frame is done before it was
+// read, as the 360's GPU, a frame behind, never did. returns false if the wait ran out
+void ExternalFrameDone();
+bool WaitExternalFrame(std::chrono::milliseconds limit);
+
+}  // namespace rex::ui
