+        REXLOG_INFO("[fps] guest {} swaps/s, worst gap {:.1f} ms | {}", swaps, worst_ms, gaps);
+        window_start = now;
+        swaps = 0;
+        worst_ms = 0;
+        gaps.clear();
+      }
+    }
