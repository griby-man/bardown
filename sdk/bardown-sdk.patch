+namespace {
+// set while a renderer other than the gpu emulation owns the picture; only its refreshes get through
+std::atomic<bool> guest_output_external{false};
+thread_local bool external_refresh = false;
+}  // namespace
+
+void SetGuestOutputExternal(bool external) { guest_output_external.store(external); }
+
+namespace {
+std::mutex external_frames_mutex;
+std::condition_variable external_frames_cv;
+uint64_t external_frames_done = 0, external_frames_taken = 0;
+}  // namespace
+
+void ExternalFrameDone() {
+  {
+    std::lock_guard lock(external_frames_mutex);
+    ++external_frames_done;
+  }
+  external_frames_cv.notify_all();
+}
+
+bool WaitExternalFrame(std::chrono::milliseconds limit) {
+  if (!guest_output_external.load()) return true;
+  std::unique_lock lock(external_frames_mutex);
+  if (!external_frames_cv.wait_for(lock, limit, [] { return external_frames_done > external_frames_taken; }))
+    return false;
+  ++external_frames_taken;
+  return true;
+}
+
+bool RefreshGuestOutputExternal(Presenter& presenter, uint32_t frontbuffer_width,
+                                uint32_t frontbuffer_height, uint32_t display_aspect_ratio_x,
+                                uint32_t display_aspect_ratio_y,
+                                std::function<bool(Presenter::GuestOutputRefreshContext& context)> refresher) {
+  external_refresh = true;
+  bool refreshed = presenter.RefreshGuestOutput(frontbuffer_width, frontbuffer_height, display_aspect_ratio_x,
+                                                display_aspect_ratio_y, std::move(refresher));
+  external_refresh = false;
+  return refreshed;
+}
+
 bool Presenter::RefreshGuestOutput(
     uint32_t frontbuffer_width, uint32_t frontbuffer_height, uint32_t display_aspect_ratio_x,
     uint32_t display_aspect_ratio_y,
     std::function<bool(GuestOutputRefreshContext& context)> refresher) {
+  if (guest_output_external.load(std::memory_order_relaxed) && !external_refresh) {
+    return false;
+  }
   GuestOutputProperties& writable_properties =
       guest_output_properties_[guest_output_mailbox_writable_];
   writable_properties.frontbuffer_width = frontbuffer_width;
