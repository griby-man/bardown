diff --git a/src/graphics/native/plugin_main.cpp b/src/graphics/native/plugin_main.cpp
new file mode 100644
index 0000000..94b3aac
--- /dev/null
+++ b/src/graphics/native/plugin_main.cpp
@@ -0,0 +1,87 @@
+/**
+ * @file        graphics/native/plugin_main.cpp
+ * @brief       rexgpu-native: no GPU emulation, for a program that draws natively from its own hooks
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ *
+ * @remarks     keeps the command stream's mechanics (fences, waits, indirect buffers, interrupts, the swap
+ *              count) and draws nothing. the window and the Vulkan device come from the runtime's provider
+ */
+
+#include <chrono>
+#include <memory>
+#include <string_view>
+#include <unordered_map>
+
+#include <xxhash.h>
+
+#include <rex/graphics/command_processor.h>
+#include <rex/graphics/graphics_system.h>
+#include <rex/graphics/pipeline/shader/shader.h>
+#include <rex/logging.h>
+#include <rex/system/gpu_plugin.h>
+#include <rex/system/kernel_state.h>
+#include <rex/ui/external_output.h>
+#include <rex/ui/vulkan/provider.h>
+
+namespace rex::graphics::native {
+namespace {
+
+class NullCommandProcessor : public CommandProcessor {
+ public:
+  using CommandProcessor::CommandProcessor;
+
+ protected:
+  bool SetupContext() override { return true; }
+  void ShutdownContext() override { shaders_.clear(); }
+  // the frame is the program's: the stream goes on once it's been shown
+  void IssueSwap(uint32_t, uint32_t, uint32_t) override {
+    rex::ui::WaitExternalFrame(std::chrono::milliseconds(100));
+  }
+  Shader* LoadShader(xenos::ShaderType shader_type, uint32_t, const uint32_t* host_address,
+                     uint32_t dword_count) override {
+    const uint64_t hash = XXH3_64bits(host_address, dword_count * sizeof(uint32_t));
+    auto& shader = shaders_[hash ^ uint64_t(shader_type)];
+    if (!shader) shader = std::make_unique<Shader>(shader_type, hash, host_address, dword_count);
+    return shader.get();
+  }
+  bool IssueDraw(xenos::PrimitiveType, uint32_t, IndexBufferInfo*, bool) override { return true; }
+  bool IssueCopy() override { return true; }
+
+ private:
+  std::unordered_map<uint64_t, std::unique_ptr<Shader>> shaders_;
+};
+
+class NativeGraphicsSystem : public GraphicsSystem {
+ public:
+  std::string name() const override { return "native"; }
+
+ protected:
+  void CreateProvider(bool with_presentation) override {
+    provider_ = rex::ui::vulkan::VulkanProvider::Create(true, with_presentation);
+  }
+
+ private:
+  std::unique_ptr<CommandProcessor> CreateCommandProcessor() override {
+    return std::make_unique<NullCommandProcessor>(this, kernel_state_);
+  }
+};
+
+}  // namespace
+}  // namespace rex::graphics::native
+
+extern "C" REX_GPU_PLUGIN_EXPORT uint32_t rex_gpu_abi_version(void) {
+  return rex::system::kGpuPluginAbiVersion;
+}
+
+extern "C" REX_GPU_PLUGIN_EXPORT rex::system::IGraphicsSystem* rex_gpu_create(
+    uint32_t abi_version, const rex::system::GpuCreateInfo* info) {
+  if (abi_version != rex::system::kGpuPluginAbiVersion || !info ||
+      info->struct_size < sizeof(rex::system::GpuCreateInfo)) {
+    REXLOG_ERROR("rexgpu-native: ABI {} or create info doesn't match (plugin is ABI {})", abi_version,
+                 rex::system::kGpuPluginAbiVersion);
+    return nullptr;
+  }
+  return new rex::graphics::native::NativeGraphicsSystem();
+}
